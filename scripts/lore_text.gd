extends RefCounted

const OBJECTIVE_TEXT := "Я ушел тайно. Старейшины запретили искать сестру, но ждать больше невозможно. Она нашла этот комплекс и верила, что его станции могут подавить охотников и открыть путь из лабиринта. Потом она пропала.\n\nЯ стою у начальной двери. Где-то рядом должна быть Станция 1. Если сестра добралась сюда, там останется след."
const NOTE_ONE_TEXT := "Станция узнала сестру: она активировала этот узел и ушла выше. Значит, я еще иду по ее следу.\n\nЗдесь можно покупать башни и турели. Связанные башни расширяют безопасную сеть и подавляют возрождение охотников. Выше находится Станция 2. Мне нужно найти ее и подключить к этой сети."
const NOTE_TWO_TEXT := "Она была здесь. Запись короткая: сестра восстановила Станцию 2 и продолжила путь наверх.\n\nВпереди Станция 3 и финальная дверь. Система требует соединить башнями начальную и финальную двери. Тогда весь маршрут станет безопасным и выход разблокируется."
const NOTE_THREE_TEXT := "Станция сообщает, что сестра добралась сюда тяжело раненной и ушла к финальной двери. По старой оценке системы, она погибла где-то выше. Но тела нет в записях.\n\nЕще страннее другое: станция называет требование о сети устаревшим и предлагает открыть финальную дверь без подготовки. Слишком удобный совет. После всего пути я не уверен, что этому узлу можно доверять."
const BAD_FINAL_TEXT := "Я открыл дверь без сети. Станция 3 солгала не случайно. Ее контролировал тот же разум, что направлял охотников. Система не позволяла ему открыть выход без воли человека, и я сделал это за него.\n\nОхотники хлынули наружу. Поселения падали одно за другим, а открытый мир снова превратился в поле войны. Где-то возникнет новое сопротивление, но для множества людей уже слишком поздно."
const GOOD_FINAL_TEXT := "Я не поверил Станции 3 и довел сеть до двери. Ложь раскрылась: враждебный разум хотел использовать меня, чтобы выпустить охотников наружу. Безопасная сеть подавила его.\n\nСестра жива. Она прошла через эту дверь раньше меня. После перехода дверь закрывается, сеть гаснет, а охотники со временем уничтожают все сооружения. Так исчез ее путь.\n\nЯ могу уйти сейчас и искать ее. Или остаться, вернуть сюда общину и вывести всех, пока сеть еще держится."
const LEAVE_ENDING_TEXT := "Я выбрал сестру. У меня не осталось сил для еще одной войны. Я вышел в открытый мир и отправился по ее следу.\n\nЗа моей спиной сеть погасла, лабиринт ожил и снова закрыл путь. Никто из общины не смог повторить мой переход. Родные, друзья и их дети остались в убежище, пока его запасов не стало слишком мало. Я нашел свободу, но цена этого выбора будет идти рядом со мной."
const COMMUNITY_ENDING_TEXT := "Я остался. Когда сеть начала гаснуть, охотники вернулись, но на этот раз путь был подготовлен. Я удержал башни, уничтожил последних стражей комплекса и вернулся за общиной.\n\nМы вывели всех: семьи, детей, стариков, запасы и память о доме. Только после этого я прошел через дверь последним. Теперь они свободны, а я отправляюсь искать сестру и спросить, почему она ушла одна."
const STATION_INSTRUCTIONS := "1. Убивай охотников, забирай энергоядра и сдавай их на Станции 1.\n\n2. Исследуй клетки карты и сдавай накопленные очки исследования.\n\n3. Ищи мегаядра и возвращай их на Станцию 1.\n\n4. За ядра и исследование ты получаешь энергию. Чем выше уровень врага или зоны, тем выше награда.\n\n5. На Станции 1 покупай здоровье, патроны, турели и башни.\n\n6. Колесом мыши выбирай режим установки башни, установки турели, стрельбы или предохранителя. Установка и демонтаж башни или турели правой кнопкой занимают две секунды.\n\n7. Башня подключается к двери станции, начальной или финальной двери либо другой подключенной башне в прямой видимости. Желтые линии показывают сеть.\n\n8. Подключенная башня создает безопасную зону вокруг себя. Враги там не появляются, но могут войти и разрушить башню.\n\n9. Сеть расходует питание, пока создает безопасную зону вне станций. Сдача энергоядра добавляет 15 секунд, мегаядра - 4 минуты. Максимальный запас питания - 30 минут. При отключении питания сооружения остаются на месте.\n\n10. Клавишей E можно передать башне здоровье, а турели - здоровье и патроны.\n\n11. Чем больше безопасная зона, тем меньше врагов остается на карте.\n\n12. Чем выше по карте, тем сильнее враги. Станции 2 и 3 сразу создают отдельные безопасные анклавы. Чтобы включить их устройства и прочитать заметки, доведи до их дверей цепочку башен от Станции 1.\n\n13. Для безопасного выхода соедини начальную и финальную двери непрерывной цепочкой башен."


static func objective_text() -> String:
	return TranslationServer.translate(OBJECTIVE_TEXT)


static func station_instructions() -> String:
	var instructions := TranslationServer.translate(STATION_INSTRUCTIONS)
	instructions = instructions.replace(
		TranslationServer.translate(
			"Клавишей E можно передать башне здоровье, а турели - здоровье и патроны."
		),
		TranslationServer.translate(
			"Клавишей E можно за энергию ремонтировать башни и пополнять здоровье и патроны турелей."
		)
	)
	return instructions.replace(
		TranslationServer.translate(
			"Чем выше по карте, тем сильнее враги. Найди Станции 2 и 3: там за энергию можно улучшать урон, здоровье и боезапас."
		),
		TranslationServer.translate(
			"Чем выше по карте, тем сильнее враги. Урон, здоровье и боезапас можно улучшать на Станции 1."
		)
	)


static func note_text(note_number: int) -> String:
	match note_number:
		0:
			return objective_text()
		1:
			return TranslationServer.translate(NOTE_ONE_TEXT)
		2:
			return TranslationServer.translate(NOTE_TWO_TEXT)
		3:
			return TranslationServer.translate(NOTE_THREE_TEXT)
	return ""


static func bad_final_text() -> String:
	return TranslationServer.translate(BAD_FINAL_TEXT)


static func good_final_text() -> String:
	return TranslationServer.translate(GOOD_FINAL_TEXT)


static func leave_ending_text() -> String:
	return TranslationServer.translate(LEAVE_ENDING_TEXT)


static func community_ending_text() -> String:
	return TranslationServer.translate(COMMUNITY_ENDING_TEXT)
